{
  "name": "onekeygo-studio-desktop",
  "version": "2.0.100",
  "description":  "eggfans Studio",
    "private":  true,
    "type":  "module",
    "main":  "main.mjs",
    "scripts":  {
                    "prepare:runtime":  "npm run build --prefix ../backend \u0026\u0026 npm run generate --prefix ../frontend \u0026\u0026 node scripts/prepare-runtime.mjs",
                    "dev":  "npm run prepare:runtime \u0026\u0026 electron .",
                    "pack":  "npm run prepare:runtime \u0026\u0026 electron-builder --dir",
                    "dist:win":  "npm run prepare:runtime \u0026\u0026 electron-builder --win nsis --x64",
                    "test":  "node --test test/*.test.mjs"
                },
    "dependencies":  {
                         "@ai-sdk/google":  "3.0.79",
                         "@ai-sdk/openai":  "3.0.65",
                         "@hono/node-server":  "1.19.14",
                         "@mastra/core":  "1.17.0",
                         "better-sqlite3":  "12.11.1",
                         "drizzle-orm":  "0.45.2",
                         "ffmpeg-static":  "^5.3.0",
                         "ffprobe-static":  "^3.1.0",
                         "fluent-ffmpeg":  "2.1.3",
                         "hono":  "4.12.22",
                         "pino":  "10.3.1",
                         "sharp":  "0.34.5",
                         "uuid":  "13.0.2",
                         "ws":  "8.21.0",
                         "yaml":  "2.9.0",
                         "zod":  "4.4.3"
                     },
    "devDependencies":  {
                            "electron":  "^43.3.0",
                            "electron-builder":  "^26.15.3"
                        },
    "build":  {
                  "electronDownload":  {
                                           "mirror":  "https://npmmirror.com/mirrors/electron/"
                                       },
                  "appId":  "com.onekeygo.studio",
                  "productName":  "eggfans Studio",
                  "artifactName":  "eggfans-Studio-Setup-${version}-${arch}.${ext}",
                  "asar":  true,
                  "asarUnpack":  [
                                     "node_modules/better-sqlite3/**/*",
                                     "node_modules/sharp/**/*",
                                     "node_modules/@img/**/*",
                                     "node_modules/ffmpeg-static/**/*",
                                     "node_modules/ffprobe-static/**/*"
                                 ],
                  "npmRebuild":  true,
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "main.mjs",
                                "preload.cjs",
                                "runtime-utils.mjs",
                                "comfyui-worker.mjs",
                                "comfyui-nodes/**/*.py",
                                "runtime/**/*",
                                "package.json"
                            ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "runtime/app-icon.png"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "perMachine":  false,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "eggfans Studio",
                               "deleteAppDataOnUninstall":  false
                           }
              }
}
